[Version]
Signature           = "$CHICAGO$" ;all windows os
Class               = Media
ClassGUID           = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider            = %AVer.Provider%
CatalogFile         = %TargetName%.cat
DriverVer=06/11/2020,3.2802.64.40

[Manufacturer]
%AVer.Provider% = AVer.Device,NTamd64


;----------------------------------------------------------------------------
;                 Supported PnpIDs
;----------------------------------------------------------------------------

[AVer.Device.NTamd64]
%AVer.DeviceDesc% = AVer.Install.NTamd64,USB\VID_07ca&PID_c835
%AVer.DeviceDesc% = AVer.Install.NTamd64,USB\VID_07ca&PID_d835

;----------------------------------------------------------------------------
;                 Installation Entries
;----------------------------------------------------------------------------

[AVer.Install.NTamd64]
Include     = ks.inf, kscaptur.inf, ksfilter.inf
Needs       = KS.Registration,KSCAPTUR.Registration.NT
AddReg      = AVer.AddReg,AVer.PinNames,AVer.AddMediaCategory.NTamd64
CopyFiles   = AVer.CopyFiles,DSFilters.CopyFiles.NTamd64,DSFilters_x86Inx64.CopyFiles.NTamd64
RegisterDlls= DSFilters.RegDLL.NTamd64,DSFilters_x86Inx64.RegDLL.NTamd64
KnownFiles  = AVer.KnownFiles   


[DestinationDirs]
AVer.CopyFiles = 10,system32\drivers
DSFilters.CopyFiles.NTamd64 = 11
DSFilters_x86Inx64.CopyFiles.NTamd64 = 16425


[AVer.DelList]
%TargetName%.sys
PropPage.ax

[AVer.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,%TargetName%.sys
HKR,,PageOutWhenUnopened,3,00
HKR,,DontSuspendIfStreamsAreRunning,3,01

HKLM,SOFTWARE\qpixel\ql201, "USBFriendlyName",, %AVer.DeviceDesc%
HKLM,SOFTWARE\qpixel\ql201, "USBDecFriendlyName",, %AVer.Decoder%
HKLM,SOFTWARE\qpixel\ql201, StartInitArmLoop,0x00010001,0
HKLM,SOFTWARE\qpixel\ql201, EnableMiscSettings,0x00010001,0



;----------------------------------------------------------------------------
;                 Add the Property Pages
;----------------------------------------------------------------------------


HKCR,CLSID\%GUID.Config_Properties%\InprocServer32,ThreadingModel,,Both
HKLM,%MediaSets%\%GUID.QLDEV_CONTROL_PROPERTIES%\PropertyPages\%GUID.Config_Properties%,,,



HKCR,CLSID\%GUID.System_Properties%\InprocServer32,ThreadingModel,,Both
HKLM,%MediaSets%\%GUID.QLDEV_CONTROL_PROPERTIES%\PropertyPages\%GUID.System_Properties%,,,



HKCR,CLSID\%GUID.Video_Properties2%\InprocServer32,ThreadingModel,,Both
HKLM,%MediaSets%\%GUID.QLDEV_CONTROL_PROPERTIES%\PropertyPages\%GUID.Video_Properties2%,,,


HKCR,CLSID\%GUID.Audio_Properties%\InprocServer32,ThreadingModel,,Both
HKLM,%MediaSets%\%GUID.QLDEV_CONTROL_PROPERTIES%\PropertyPages\%GUID.Audio_Properties%,,,


HKCR,CLSID\%GUID.Coding_Properties%\InprocServer32,ThreadingModel,,Both
HKLM,%MediaSets%\%GUID.QLDEV_CONTROL_PROPERTIES%\PropertyPages\%GUID.Coding_Properties%,,,

HKCR,CLSID\%GUID.Diag_Properties%\InprocServer32,,,PropPage.ax
HKCR,CLSID\%GUID.Diag_Properties%\InprocServer32,ThreadingModel,,Both
HKLM,%MediaSets%\%GUID.QLDEV_CONTROL_PROPERTIES%\PropertyPages\%GUID.Diag_Properties%,,,



HKCR,CLSID\%GUID.Decode_Properties2%\InprocServer32,ThreadingModel,,Both
HKLM,%MediaSets%\%GUID.QLDEV_CONTROL_PROPERTIES%\PropertyPages\%GUID.Decode_Properties2%,,,


HKCR,CLSID\%GUID.Decode_Properties2%\InprocServer32,ThreadingModel,,Both
HKLM,%MediaSets%\%GUID.QLDEV_CONTROL_PROPERTIES%\PropertyPages\%GUID.Wizard_Properties%,,,

